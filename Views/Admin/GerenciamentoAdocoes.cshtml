                    <div class="timeline-container-pro" id="timelineContainer">
                    </div>
                </div>

                <div class="secao-historico-adotante">
                    <div class="timeline-header-pro">
                        <h4 class="timeline-title-pro">Histórico de Adoções do Adotante</h4>
                        <div class="timeline-subtitle">Adoções anteriores realizadas por este usuário</div>
                    </div>
                    <div class="historico-container-pro" id="historicoAdotanteContainer">
                        <div class="sem-historico">Carregando histórico...</div>
                    </div>
                </div>

                <!-- SEÇÃO CONTRATO DIGITAL -->
                <div class="secao-principal mt-4">
                    <div class="contrato-container">
                        <div class="contrato-header">
                            <div class="contrato-title-section">
                                <h4 class="contrato-title">Contrato Digital de Adoção</h4>
                                <span class="contrato-subtitle" id="contratoStatusText">Documento legal digital</span>
                            </div>
