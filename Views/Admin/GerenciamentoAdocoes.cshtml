                    contratoStatusInfo.innerHTML = `
                        <div style="text-align: center; padding: 40px;">
                            <div style="font-size: 48px; margin-bottom: 20px; color: #ffc107;">⏳</div>
                            <h4 style="color: #ffc107; margin-bottom: 16px;">Aguardando Assinatura</h4>
                            <p style="line-height: 1.6; margin: 0; color: #666;">O contrato foi gerado e enviado para o adotante. Aguardando assinatura digital.</p>
                        </div>
                    `;
                } else {
                    // Contrato não disponível
                    if (contratoStatusText) {
                        contratoStatusText.textContent = 'Contrato ainda não foi gerado';
                        contratoStatusText.style.color = '#6c757d';
                    }

                    contratoStatusInfo.innerHTML = `
                        <div style="text-align: center; padding: 40px;">
                            <div style="font-size: 48px; margin-bottom: 20px; color: #6c757d;">📄</div>
                            <h4 style="color: #6c757d; margin-bottom: 16px;">Contrato Não Disponível</h4>
                            <p style="line-height: 1.6; margin: 0; color: #666;">O contrato será gerado automaticamente quando a adoção for aprovada.</p>
                        </div>
                    `;
                }
            }


            // Função removida - botões de ação agora estão na listagem principal

            // Função para finalizar adoção
            function finalizarAdocao(adocaoId, observacoes) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const btnFinalizar = document.getElementById('confirmarFinalizacao');

                // Obter data e hora atuais
                const agora = new Date();
                const dataFinalizacao = agora.toISOString();

                fetch(`/admin/adocoes/finalizar/${adocaoId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        observacoes: observacoes,
                        dataFinalizacao: dataFinalizacao
                    })
                })
                .then(response => response.json())
                .then(data => {
                    // Reabilitar botão
                    if (btnFinalizar) {
                        btnFinalizar.disabled = false;
                        btnFinalizar.textContent = 'Finalizar Adoção';
                    }

                    if (data.sucesso) {
                        // Fechar modal de finalizar de forma segura
                        const modalFinalizar = document.getElementById('modalFinalizarAdocao');
                        if (modalFinalizar) {
                            let modalInstance = bootstrap.Modal.getInstance(modalFinalizar);
                            if (!modalInstance) {
                                modalInstance = new bootstrap.Modal(modalFinalizar);
                            }
                            modalInstance.hide();
                        }

                        // Fechar modal de detalhes de forma segura
                        const modalDetalhes = document.getElementById('modal-adoption-details');
                        if (modalDetalhes) {
                            let modalInstance = bootstrap.Modal.getInstance(modalDetalhes);
                            if (!modalInstance) {
                                modalInstance = new bootstrap.Modal(modalDetalhes);
                            }
                            modalInstance.hide();
                        }

                        toastr.success(data.mensagem || 'Adoção finalizada com sucesso!');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        toastr.error(data.mensagem || 'Erro ao finalizar adoção.');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    // Reabilitar botão em caso de erro
                    if (btnFinalizar) {
                        btnFinalizar.disabled = false;
                        btnFinalizar.textContent = 'Finalizar Adoção';
                    }
                    toastr.error('Erro ao processar solicitação.');
                });
            }

            // Função para cancelar adoção
            function cancelarAdocao(adocaoId, motivo, observacoes) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                fetch(`/admin/adocoes/cancelar/${adocaoId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ motivo: motivo, observacoes: observacoes })
                })
                .then(response => response.json())
                .then(data => {
                    bootstrap.Modal.getInstance(document.getElementById('modalCancelarAdocao')).hide();
                    bootstrap.Modal.getInstance(document.getElementById('modal-adoption-details')).hide();
                    
                    if (data.sucesso) {
                        toastr.success(data.mensagem || 'Adoção cancelada com sucesso!');
                        setTimeout(() => window.location.reload(), 1500);
                    } else {
                        toastr.error(data.mensagem || 'Erro ao cancelar adoção.');
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    toastr.error('Erro ao processar solicitação.');
                });
            }

            // Handler global para erros não capturados e prevenir erros de canal assíncrono
            window.addEventListener('error', function(event) {
                if (event.error && event.error.message.includes('message channel closed')) {
                    // Silenciar erros de extensão do browser
                    event.preventDefault();
                    return;
                }
                console.error('Erro global capturado:', event.error);
            });

            window.addEventListener('unhandledrejection', function(event) {
                if (event.reason && event.reason.message && event.reason.message.includes('message channel closed')) {
                    // Silenciar erros de extensão do browser
                    event.preventDefault();
                    return;
                }
                console.error('Promise rejeitada não tratada:', event.reason);
            });

            // As abas agora usam Bootstrap nativo, não precisamos de JS customizado

            // BOTÕES FINALIZAR E CANCELAR AGORA USAM MODAIS (configurados acima)

            // Botões de cancelamento por violação
            const botoesViolacao = document.querySelectorAll('.btn-cancelar-violacao');
            botoesViolacao.forEach(btn => {
                btn.addEventListener('click', function() {
                    const adocaoId = this.dataset.adocaoId;
                    
                    // Confirmar ação crítica
                    if (!confirm('ATENÇÃO: Você está prestes a cancelar uma adoção finalizada por violação de termos.\n\nEsta ação é IRREVERSÍVEL e muito séria.\n\nTem certeza que deseja continuar?')) {
                        return;
                    }
                    
                    const motivo = prompt('Descreva detalhadamente a violação que motivou este cancelamento:\n\n(Esta informação será registrada no sistema e enviada ao adotante)');
                    
                    if (motivo && motivo.trim().length > 10) {
                        // Criar form dinamicamente e submeter
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/admin/adocoes/cancelar-por-violacao/${adocaoId}`;
                        
                        const motivoInput = document.createElement('input');
                        motivoInput.type = 'hidden';
                        motivoInput.name = 'motivo';
                        motivoInput.value = motivo;
                        form.appendChild(motivoInput);
                        
                        const token = document.querySelector('input[name="__RequestVerificationToken"]');
                        if (token) {
                            const tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '__RequestVerificationToken';
                            tokenInput.value = token.value;
                            form.appendChild(tokenInput);
                        }
                        
                        document.body.appendChild(form);
                        form.submit();
                    } else if (motivo !== null) {
                        alert('É obrigatório fornecer uma descrição detalhada da violação (mínimo 10 caracteres).');
                    }
                });
            });

            // CONFIGURAR TOASTR
            if (typeof toastr !== 'undefined') {
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "timeOut": "5000",
                    "preventDuplicates": true
                };
            }

            // Configurar eventos dos modais para capturar ID da adoção
            const modalFinalizar = document.getElementById('modalFinalizarAdocao');
            if (modalFinalizar) {
                modalFinalizar.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget; // Botão que acionou o modal
                    const adocaoId = button.getAttribute('data-adocao-id');
                    
                    // Definir o ID da adoção no modal
                    document.getElementById('adocaoIdFinalizar').value = adocaoId;
                    
                    // Limpar campos
                    document.getElementById('observacoesFinalizacao').value = '';
                    document.getElementById('confirmFinalizacao').checked = false;
                });
            }

            const modalCancelar = document.getElementById('modalCancelarAdocao');
            if (modalCancelar) {
                modalCancelar.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget; // Botão que acionou o modal
                    const adocaoId = button.getAttribute('data-adocao-id');
                    
                    // Definir o ID da adoção no modal
                    document.getElementById('adocaoIdCancelar').value = adocaoId;
                    
                    // Limpar campos
                    document.getElementById('motivoCancelamento').value = '';
                    document.getElementById('observacoesCancelamento').value = '';
                    document.getElementById('confirmCancelamento').checked = false;
                });
            }

            // CONFIGURAR BOTÕES CUSTOMIZADOS DO MODAL DE DETALHES
            const btnCloseModal = document.getElementById('btnCloseModal');
            const btnFecharModal = document.getElementById('btnFecharModal');

            if (btnCloseModal) {
                btnCloseModal.addEventListener('click', function() {
                    console.log('Botão X clicado - tentando fechar modal');

                    // Sempre permitir fechar
                    const modal = document.getElementById('modal-adoption-details');
                    if (modal) {
                        const modalInstance = bootstrap.Modal.getInstance(modal);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                });
            }

            if (btnFecharModal) {
                btnFecharModal.addEventListener('click', function() {
                    console.log('Botão Fechar clicado - tentando fechar modal');

                    // Sempre permitir fechar
                    const modal = document.getElementById('modal-adoption-details');
                    if (modal) {
                        const modalInstance = bootstrap.Modal.getInstance(modal);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                });
            }

            // Event listener para botão Finalizar Adoção
            const btnFinalizarAdocao = document.getElementById('confirmarFinalizacao');
            if (btnFinalizarAdocao) {
                btnFinalizarAdocao.addEventListener('click', function() {
                    console.log('Botão Finalizar Adoção clicado');

                    // Verificar se o checkbox está marcado
                    const checkbox = document.getElementById('confirmFinalizacao');
                    if (!checkbox || !checkbox.checked) {
                        alert('Por favor, confirme que o pet foi entregue ao adotante.');
                        return;
                    }

                    // Obter dados
                    const adocaoId = document.getElementById('adocaoIdFinalizar')?.value;
                    const observacoes = document.getElementById('observacoesFinalizacao')?.value || '';

                    if (!adocaoId) {
                        console.error('ID da adoção não encontrado');
                        alert('Erro: ID da adoção não encontrado.');
                        return;
                    }

                    console.log('Finalizando adoção:', adocaoId, 'Observações:', observacoes);

                    // Desabilitar botão para evitar duplo clique
                    this.disabled = true;
                    this.textContent = 'Finalizando...';

                    // Chamar função de finalizar
                    finalizarAdocao(adocaoId, observacoes);
                });
            }

            // Event listener para botão Cancelar Adoção
            const btnCancelarAdocao = document.getElementById('confirmarCancelamento');
            if (btnCancelarAdocao) {
                btnCancelarAdocao.addEventListener('click', function() {
                    console.log('Botão Cancelar Adoção clicado');

                    // Verificar se o checkbox está marcado
                    const checkbox = document.getElementById('confirmCancelamento');
                    if (!checkbox || !checkbox.checked) {
                        alert('Por favor, confirme que deseja cancelar esta adoção.');
                        return;
                    }

                    // Obter dados
                    const adocaoId = document.getElementById('adocaoIdCancelar')?.value;
                    const motivo = document.getElementById('motivoCancelamento')?.value || '';
                    const observacoes = document.getElementById('observacoesCancelamento')?.value || '';

                    if (!adocaoId) {
                        console.error('ID da adoção não encontrado');
                        alert('Erro: ID da adoção não encontrado.');
                        return;
                    }

                    if (!motivo.trim()) {
                        alert('Por favor, selecione um motivo para o cancelamento.');
                        return;
                    }

                    console.log('Cancelando adoção:', adocaoId, 'Motivo:', motivo, 'Observações:', observacoes);

                    // Desabilitar botão para evitar duplo clique
                    this.disabled = true;
                    this.textContent = 'Cancelando...';

                    // Chamar função de cancelar
                    cancelarAdocao(adocaoId, motivo, observacoes);
                });
            }
        });


        // Funções de filtro igual à view de formulários
        function filtrarAdocoes() {
            const searchTerm = document.getElementById('search-input').value.toLowerCase();
            const statusFilter = document.getElementById('filter-status').value.toLowerCase();
            const dataFilter = document.getElementById('filter-data').value;
            
            const rows = document.querySelectorAll('.tabela tbody tr');
            
            rows.forEach(row => {
                const nomeAdotante = row.querySelector('.nome')?.textContent.toLowerCase() || '';
                const emailAdotante = row.querySelector('.email')?.textContent.toLowerCase() || '';
                const nomePet = row.querySelector('.info-pet .nome')?.textContent.toLowerCase() || '';
                const status = row.dataset.status?.toLowerCase() || '';
                
                const matchesSearch = nomeAdotante.includes(searchTerm) || 
                                    emailAdotante.includes(searchTerm) || 
                                    nomePet.includes(searchTerm);
                
                const matchesStatus = !statusFilter || status.includes(statusFilter);
                
                // Filtro de data seria implementado baseado na DataEnvio
                const matchesData = true; // Simplificado para agora
                
                if (matchesSearch && matchesStatus && matchesData) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        
        function limparFiltros() {
            document.getElementById('search-input').value = '';
            document.getElementById('filter-status').value = '';
            document.getElementById('filter-data').value = '';
            
            const rows = document.querySelectorAll('.tabela tbody tr');
            rows.forEach(row => {
                row.style.display = '';
            });
        }
    </script>
