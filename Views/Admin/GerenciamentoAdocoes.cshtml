            // Nova função simples para contratos com estilo original
            function configurarContratoSimples(dados) {
                const contratoStatusInfo = document.getElementById('contratoStatusInfo');
                const contratoStatusText = document.getElementById('contratoStatusText');
                const contratoActions = document.getElementById('contratoActions');
                const btnDownloadContrato = document.getElementById('btnDownloadContrato');
                const btnVisualizarContrato = document.getElementById('btnVisualizarContrato');

                if (!contratoStatusInfo || !contratoActions) return;

                console.log('Configurando contrato simples:', dados.contrato);

                if (dados.contrato && dados.contrato.temContrato && dados.contrato.estaAssinado) {
                    // Contrato disponível
                    const adocaoId = document.getElementById('adocaoId').textContent;
                    const contratoUrl = `/admin/adocoes/VisualizarContrato/${adocaoId}`;

                    // Atualizar subtitle
                    if (contratoStatusText) {
                        contratoStatusText.textContent = 'Contrato assinado e disponível';
                        contratoStatusText.style.color = '#28a745';
                    }

                    // Limpar status - sem texto
                    contratoStatusInfo.innerHTML = '';

                    // Mostrar e configurar botões
                    contratoActions.style.display = 'flex';

                    if (btnDownloadContrato) {
                        btnDownloadContrato.style.display = 'block';
                        btnDownloadContrato.onclick = function() {
                            console.log('Fazendo download do contrato PDF por baixo dos panos...');

                            // Mostrar loading no botão
                            const originalText = btnDownloadContrato.innerHTML;
                            btnDownloadContrato.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Baixando...';
                            btnDownloadContrato.disabled = true;

                            // Fazer download via fetch
                            fetch(contratoUrl)
                                .then(response => {
                                    if (!response.ok) {
                                        throw new Error(`Erro ao baixar PDF: ${response.status}`);
                                    }
                                    return response.blob();
                                })
                                .then(blob => {
                                    // Criar link temporário para download
                                    const url = window.URL.createObjectURL(blob);
                                    const link = document.createElement('a');
                                    link.href = url;
                                    link.download = `Contrato_Adocao_${adocaoId}.pdf`;
                                    document.body.appendChild(link);
                                    link.click();
                                    document.body.removeChild(link);
                                    window.URL.revokeObjectURL(url);

                                    // Mostrar mensagem de sucesso
                                    if (typeof toastr !== 'undefined') {
                                        toastr.success('PDF baixado com sucesso!');
                                    }
                                })
                                .catch(error => {
                                    console.error('Erro ao baixar PDF:', error);
                                    if (typeof toastr !== 'undefined') {
                                        toastr.error('Erro ao baixar PDF: ' + error.message);
                                    } else {
                                        alert('Erro ao baixar PDF: ' + error.message);
                                    }
                                })
                                .finally(() => {
                                    // Restaurar botão
                                    btnDownloadContrato.innerHTML = originalText;
                                    btnDownloadContrato.disabled = false;
                                });
                        };
                    }

                    if (btnVisualizarContrato) {
                        btnVisualizarContrato.style.display = 'block';
                        btnVisualizarContrato.onclick = function() {
                            console.log('Visualizando contrato PDF em nova aba...');
                            window.open(contratoUrl, '_blank');
                        };
                    }

                } else if (dados.contrato && dados.contrato.temContrato && !dados.contrato.estaAssinado) {
                    // Contrato não assinado
                    if (contratoStatusText) {
                        contratoStatusText.textContent = 'Aguardando assinatura do adotante';
                        contratoStatusText.style.color = '#ffc107';
