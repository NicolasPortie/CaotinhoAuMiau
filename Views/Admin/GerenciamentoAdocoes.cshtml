@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // MOSTRAR NOTIFICAÇÕES DO TEMPDATA (MVC)
            const sucessoMsg = document.querySelector('[data-tempdata-sucesso]')?.textContent;
            const erroMsg = document.querySelector('[data-tempdata-erro]')?.textContent;
            const avisoMsg = document.querySelector('[data-tempdata-aviso]')?.textContent;
            
            if (typeof toastr !== 'undefined') {
                if (sucessoMsg) toastr.success(sucessoMsg);
                if (erroMsg) toastr.error(erroMsg);
                if (avisoMsg) toastr.warning(avisoMsg);
            }

            // CONFIGURAR MODAL DE REJEIÇÃO (MVC)
            const botoesRejeitar = document.querySelectorAll('.btn-rejeitar-adocao');
            const modalRejeitar = document.getElementById('modal-rejeitar-adocao');
            const formRejeitar = document.getElementById('form-rejeitar-adocao');
            
            botoesRejeitar.forEach(btn => {
                btn.addEventListener('click', function() {
                    const adocaoId = this.dataset.adocaoId;
                    formRejeitar.action = `/admin/adocoes/rejeitar/${adocaoId}`;
                    
                    if (typeof bootstrap !== 'undefined') {
                        const modal = new bootstrap.Modal(modalRejeitar);
                        modal.show();
                    }
                });
            });

            // CONFIGURAR VISUALIZAÇÃO DE DETALHES (MODAL) com tratamento de erro
            try {
                const botoesVisualizar = document.querySelectorAll('.btn-visualizar-adocao');
                botoesVisualizar.forEach(btn => {
                    btn.addEventListener('click', function(event) {
                        event.preventDefault();
                        event.stopPropagation();
                        
                        try {
                            const adocaoId = this.dataset.adocaoId;
                            if (adocaoId) {
                                mostrarDetalhesAdocao(adocaoId);
                            } else {
                                console.error('ID da adoção não encontrado no botão');
                                toastr.error('Erro: ID da adoção não encontrado');
                            }
                        } catch (error) {
                            console.error('Erro ao processar clique no botão detalhes:', error);
                            toastr.error('Erro ao abrir detalhes da adoção');
                        }
                    });
                });
            } catch (error) {
                console.error('Erro ao configurar event listeners dos detalhes:', error);
            }

            // Função para mostrar detalhes da adoção no modal
            function mostrarDetalhesAdocao(adocaoId) {
                const modal = document.getElementById('modal-adoption-details');

                // Debug: adicionar logs detalhados
                console.log('=== INICIANDO ABERTURA DO MODAL ===');
                console.log('Modal encontrado:', modal);
                console.log('Adoção ID:', adocaoId);

                // Limpar estados anteriores
                if (window.allowModalClose) {
                    window.allowModalClose();
                }

                // Criar nova instância do modal e abrir
                const modalInstance = new bootstrap.Modal(modal, {
                    backdrop: 'static',
                    keyboard: false
                });

                // Adicionar listeners de debug
                modal.addEventListener('show.bs.modal', function() {
                    console.log('Modal começando a abrir');
                });

                modal.addEventListener('shown.bs.modal', function() {
                    console.log('Modal totalmente aberto');
                });

                modal.addEventListener('hide.bs.modal', function(e) {
                    console.log('Tentativa de fechamento detectada:', e);
                });

                modal.addEventListener('hidden.bs.modal', function() {
                    console.log('Modal fechado completamente');
                });

                modalInstance.show();
                console.log('Comando show() executado');

                // Buscar dados via AJAX
                fetch(`/admin/adocoes/detalhes/${adocaoId}`, {
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data && data.sucesso) {
                        preencherDetalhesModal(data.dados);
                    } else {
                        throw new Error(data?.mensagem || 'Erro ao carregar detalhes da adoção');
                    }
                })
                .catch(error => {
                    console.error('Erro ao carregar detalhes:', error);
                    toastr.error(error.message || 'Erro ao carregar detalhes');
                    bootstrap.Modal.getInstance(modal).hide();
                });
            }

            // Função para preencher o modal com os dados
            function preencherDetalhesModal(dados) {
                console.log('Preenchendo modal com dados:', dados);
                
                // Armazenar dados globalmente para uso nas abas
                window.currentAdocaoData = dados;
                
                // Definir ID da adoção no header
                if (dados.id) {
                    document.getElementById('adocaoId').textContent = dados.id;
                }
                
                // Preencher informações do pet
                if (dados.pet) {
                    document.getElementById('detalhesNomePet').textContent = dados.pet.nome || '-';
                    document.getElementById('detalhesEspeciePet').textContent = dados.pet.especie || '-';
                    document.getElementById('detalhesRacaPet').textContent = dados.pet.raca || '-';
                    document.getElementById('detalhesPortePet').textContent = dados.pet.porte || '-';
                    document.getElementById('detalhesSexoPet').textContent = dados.pet.sexo || '-';
                    document.getElementById('detalhesIdadePet').textContent = dados.pet.idade ? `${dados.pet.idade} anos` : '-';
                    
                    // Imagem do pet
                    const petImg = document.getElementById('detalhesPetImagem');
                    if (dados.pet.imagem) {
                        petImg.src = `/imagens/pets/${dados.pet.imagem}`;
                        petImg.alt = dados.pet.nome;
                        petImg.onerror = function() {
                            this.src = '/imagens/pets/placeholder.jpg';
                        };
                    }
                }

                // Preencher informações do adotante
                if (dados.usuario) {
                    document.getElementById('detalhesNomeAdotante').textContent = dados.usuario.nome || '-';
                    document.getElementById('detalhesEmailAdotante').textContent = dados.usuario.email || '-';
                    document.getElementById('detalhesTelefoneAdotante').textContent = dados.usuario.telefone || '-';
                    document.getElementById('detalhesCpfAdotante').textContent = dados.usuario.cpf || '-';

                    // Avatar do adotante
                    const avatarElement = document.getElementById('detalhesAdotanteAvatar');
                    const inicial = dados.usuario.nome ? dados.usuario.nome.charAt(0).toUpperCase() : 'A';
                    avatarElement.textContent = inicial;

                    // Carregar histórico de adoções do adotante
                    if (dados.usuario.id) {
                        carregarHistoricoAdotante(dados.usuario.id);
                    }
                }
                
                // Criar timeline simples
                criarTimelineSimples(dados);

                // Preencher dados do formulário
                preencherDadosFormulario(dados);
                
                // Configurar botões
                configurarBotoesModal(dados);

                // Configurar contratos
                configurarContratoSimples(dados);
            }

            // Função para preencher dados do formulário
            function preencherDadosFormulario(dados) {
                if (dados.formulario) {
                    const formulario = dados.formulario;
                    
                    // Informações pessoais
                    document.getElementById('formulario-renda').textContent = 
                        formulario.rendaMensal ? `R$ ${parseFloat(formulario.rendaMensal).toLocaleString('pt-BR', {minimumFractionDigits: 2})}` : '-';
                    document.getElementById('formulario-moradores').textContent = formulario.numeroMoradores || '-';
                    
                    // Moradia
                    document.getElementById('formulario-descricao-moradia').textContent = formulario.descricaoMoradia || '-';
                    document.getElementById('formulario-espaco-adequado').textContent = formulario.espacoAdequado || '-';
                    
                    // Campos separados - agora diretos do banco de dados
                    document.getElementById('formulario-tempo-disponivel').textContent = 
                        formulario.tempoDisponivel ? `${formulario.tempoDisponivel}h por dia` : '-';
                    document.getElementById('formulario-teve-pet').textContent = 
                        formulario.tevePetAnterior || '-';
                    
                    // Experiência
                    document.getElementById('formulario-experiencia').textContent = formulario.experienciaAnterior || '-';
                    
                    // Motivação e compromisso
                    document.getElementById('formulario-motivacao').textContent = formulario.motivacaoAdocao || '-';
                    document.getElementById('formulario-condicoes-financeiras').textContent = formulario.condicoesFinanceiras || '-';
                    document.getElementById('formulario-planejamento-viagens').textContent = formulario.planejamentoViagens || '-';
                    
                    // Observações administrativas (se existirem)
                    const observacaoAdmin = formulario.observacaoAdmin || formulario.observacaoAdminFormulario;
                    if (observacaoAdmin) {
                        document.getElementById('formulario-observacao-admin').textContent = observacaoAdmin;
                        document.getElementById('secao-observacoes-admin').style.display = 'block';
                    } else {
                        document.getElementById('secao-observacoes-admin').style.display = 'none';
                    }
                } else {
                    // Limpar campos se não houver dados
                    const campos = [
                        'formulario-renda', 'formulario-moradores', 'formulario-descricao-moradia',
                        'formulario-espaco-adequado', 'formulario-experiencia', 'formulario-motivacao',
                        'formulario-condicoes-financeiras', 'formulario-planejamento-viagens',
                        'formulario-observacao-admin', 'formulario-tempo-disponivel', 'formulario-teve-pet'
                    ];
                    
                    campos.forEach(campo => {
                        const elemento = document.getElementById(campo);
                        if (elemento) elemento.textContent = '-';
                    });
                    
                    document.getElementById('secao-observacoes-admin').style.display = 'none';
                }
            }

            // Função para carregar histórico de adoções do adotante
            function carregarHistoricoAdotante(usuarioId) {
                const container = document.getElementById('historicoAdotanteContainer');
                
                // Fazer requisição real para buscar histórico
                fetch(`/admin/adocoes/HistoricoUsuario/${usuarioId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.historico && data.historico.length > 0) {
                            let html = '<div class="historico-lista">';
                            data.historico.forEach(adocao => {
                                html += `
                                    <div class="historico-item">
                                        <div class="historico-pet">
                                            <strong>${adocao.petNome}</strong>
                                            <span class="historico-especie">${adocao.petEspecie}</span>
                                        </div>
                                        <div class="historico-data">${new Date(adocao.dataAdocao).toLocaleDateString('pt-BR')}</div>
                                        <div class="historico-status ${adocao.statusCss}">${adocao.status}</div>
                                    </div>
                                `;
                            });
                            html += '</div>';
                            container.innerHTML = html;
                        } else {
                            container.innerHTML = '<div class="sem-historico">Nenhuma adoção anterior encontrada</div>';
                        }
                    })
                    .catch(error => {
                        console.error('Erro ao carregar histórico:', error);
                        container.innerHTML = '<div class="sem-historico">Nenhuma adoção anterior encontrada</div>';
                    });
            }

            // Função para criar timeline profissional
            function criarTimelineSimples(dados) {
                const timelineContainer = document.getElementById('timelineContainer');
                const statusTexto = dados.status || dados.statusAdocaoTexto;
                
                // Determinar etapa atual baseada no status
                let etapaAtual = 1;
                console.log('Status da adoção:', statusTexto, 'Contrato assinado:', dados.contratoAssinado);
                
                if (statusTexto === 'Finalizado') {
                    etapaAtual = 6;
                } else if (statusTexto === 'Aguardando Buscar') {
                    etapaAtual = 5;
                } else if (dados.contratoAssinado === true) {
                    etapaAtual = 4;
                } else if (statusTexto === 'Aguardando Contrato') {
                    // Se está aguardando contrato, significa que foi aprovado mas ainda não assinou
                    etapaAtual = 3;
                } else if (statusTexto?.includes('Cancelad')) {
                    // Se foi cancelado, mostrar só até onde chegou
                    if (dados.contratoAssinado) etapaAtual = 4;
                    else if (statusTexto?.includes('Aguardando Contrato')) etapaAtual = 3;
                    else etapaAtual = 1;
                } else {
                    // Status padrão ou desconhecido - provavelmente ainda em análise
                    etapaAtual = 1;
                }
                
                // Definir passos da timeline profissional
                const passos = [
                    { nome: 'Formulário Enviado', descricao: 'Solicitação de adoção registrada', etapa: 1, data: dados.dataEnvio },
                    { nome: 'Em Análise', descricao: 'Avaliação da documentação pela equipe', etapa: 2, data: null },
                    { nome: 'Aguardando Contrato', descricao: 'Aprovado - aguardando assinatura do contrato', etapa: 3, data: dados.dataResposta },
                    { nome: 'Contrato Assinado', descricao: 'Documento legal assinado pelo adotante', etapa: 4, data: dados.contrato?.dataAssinatura },
                    { nome: 'Aguardando Buscar', descricao: 'Pet pronto para ser buscado pelo adotante', etapa: 5, data: null },
                    { nome: 'Finalizado', descricao: 'Adoção concluída com sucesso', etapa: 6, data: dados.dataFinalizacao }
                ];

                timelineContainer.innerHTML = '';
                
                passos.forEach((passo, index) => {
                    const isCompleted = passo.etapa <= etapaAtual;
                    const isCurrent = passo.etapa === etapaAtual;
                    const dataTexto = passo.data ? formatarData(passo.data) : '';
                    
                    const item = document.createElement('div');
                    item.className = `timeline-item-pro ${isCompleted ? 'completed' : 'pending'} ${isCurrent ? 'current' : ''}`;
                    
                    item.innerHTML = `
                        <div class="timeline-step-pro">
                            <div class="step-number">${passo.etapa}</div>
                            <div class="step-connector ${index === passos.length - 1 ? 'last' : ''}"></div>
                        </div>
