        .indicador-status i::before {
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }
        
        /* Se Font Awesome não carregar, mostrar texto de fallback */
        .indicador-status .fas.fa-hourglass-half::before { content: ""; }
        .indicador-status .fas.fa-check-circle::before { content: ""; }  
        .indicador-status .fas.fa-times-circle::before { content: ""; }
