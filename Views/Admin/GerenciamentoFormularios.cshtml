@model IEnumerable<CaotinhoAuMiau.Models.FormularioAdocao>
@using CaotinhoAuMiau.Models.Enums
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Gerenciamento de Formulários";
    
    var totalFormularios = ViewBag.TotalItens;
    var pendentes = Model.Where(f => f.StatusEnum == StatusFormulario.Pendente).Count();
    var aprovados = Model.Where(f => f.StatusEnum == StatusFormulario.Aprovado).Count();
    var rejeitados = Model.Where(f => f.StatusEnum == StatusFormulario.Negado).Count();
    var cancelados = Model.Where(f => f.StatusEnum == StatusFormulario.CanceladoPeloUsuario || f.StatusEnum == StatusFormulario.CanceladoPorInatividade).Count();
    

    string GetStatusClass(StatusFormulario status)
    {
        return status switch
        {
            StatusFormulario.Pendente => "pendente",
            StatusFormulario.EmAnalise => "em-analise",
            StatusFormulario.Aprovado => "aprovado",
            StatusFormulario.Negado => "rejeitado",
            StatusFormulario.CanceladoPeloUsuario => "cancelado",
            StatusFormulario.CanceladoPorInatividade => "cancelado",
            _ => "pendente"
        };
    }

    string GetStatusText(StatusFormulario status)
    {
        return status switch
        {
            StatusFormulario.Pendente => "Pendente",
            StatusFormulario.EmAnalise => "Em Análise", 
            StatusFormulario.Aprovado => "Aprovado",
            StatusFormulario.Negado => "Negado",
            StatusFormulario.CanceladoPeloUsuario => "Cancelado pelo Usuário",
            StatusFormulario.CanceladoPorInatividade => "Cancelado por Inatividade",
            0 => "Status Indefinido", // Para capturar valor padrão
            _ => $"Status {(int)status}: {status.ToString()}"
        };
    }
}


